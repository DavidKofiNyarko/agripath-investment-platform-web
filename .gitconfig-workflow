# Git aliases for the development workflow
# Add these to your ~/.gitconfig or run: git config --global alias.<name> '<command>'

[alias]
    # Start new feature from develop
    new-feature = "!f() { git checkout develop && git pull && git checkout -b feature/$1; }; f"
    
    # Push feature to develop
    finish-feature = "!f() { git checkout develop && git merge feature/$1 && git push origin develop && git branch -d feature/$1; }; f"
    
    # Quick status check
    status-dev = "!git status && echo '' && echo 'Current branch:' && git branch --show-current"
    
    # Safe push to develop (prevents pushing to main)
    push-dev = "!f() { branch=$(git branch --show-current); if [ \"$branch\" = \"main\" ]; then echo '❌ Cannot push directly to main! Use a PR instead.'; exit 1; else git push origin $branch; fi; }; f"





